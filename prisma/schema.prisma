// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model CarImage {
  id        String   @id @default(cuid())
  carId     String
  imageUrl  String
  imageName String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  
  @@unique([carId, order])
}

model Car {
  id          String   @id @default(cuid())
  make        String
  model       String
  year        Int
  price       Float
  mileage     Int
  vin         String?  @unique
  stockNumber String?  @unique
  description String?
  exteriorColor String?
  interiorColor String?
  transmission String?
  fuelType    String?
  engine      String?
  bodyStyle   String?
  driveType   String? // Added missing field
  doors       Int?
  passengers  Int?
  features    String? // JSON string for features array
  
  // Enhanced specifications
  horsepower  Int?
  torque      Int?
  mpgCity     Float?
  mpgHighway  Float?
  mpgCombined Float?
  acceleration Float? // 0-60 mph in seconds
  topSpeed    Int?
  fuelCapacity Float?
  weight      Int? // in lbs
  length      Float? // in inches
  width       Float? // in inches
  height      Float? // in inches
  wheelbase   Float? // in inches
  groundClearance Float? // in inches
  cargoVolume Float? // in cubic feet
  towingCapacity Int? // in lbs
  
  // Status flags
  isFeatured  Boolean  @default(false)
  isNewArrival Boolean  @default(false)
  isSpecialOffer Boolean @default(false)
  isSold      Boolean  @default(false)
  status      String   @default("available") // available, sold, pending
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  images      CarImage[]
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  role      String   @default("user") // user, admin
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuickActionCounts {
  id        String   @id @default(cuid())
  featured  Int      @default(0)
  newArrivals Int   @default(0)
  specialOffers Int @default(0)
  recentlyViewed Int @default(0)
  updatedAt DateTime @updatedAt
}